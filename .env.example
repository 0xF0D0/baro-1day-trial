# Copy to .env and fill in. .env is ignored by git. See "Prerequisites" in part1/README.md.

# Apify API token: sources 2, 3, 4, 6, 8, 9 and parts of 5 and 10. Without it those record "could not look".
# Keep it in this file: most collectors read the file, not the environment.
APIFY_TOKEN=

# Optional: only for labeling new ad texts (`part1/pipeline/angles.py --label`).
ANTHROPIC_API_KEY=

# Optional: the welcome-email mailbox of source 10 and an app password for it. With both set the collector reads the
# mailbox over IMAP; without them it reads the exported files in the repository.
# See part1/collectors/10_brand_site_and_emails/inbox_setup.md.
INBOX_ADDRESS=
INBOX_APP_PASSWORD=

# Optional: the Postgres to load into. This is the default; the server must be running and the database must exist.
DATABASE_URL=postgresql://localhost:5432/market_radar
# With the Postgres of part1/docker-compose.yml use this line instead:
# DATABASE_URL=postgresql://postgres@localhost:5433/market_radar
